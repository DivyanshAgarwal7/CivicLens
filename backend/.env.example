MONGODB_URI=
DB_NAME=civiclens
APP_ENV=development
ALLOW_JSON_DB=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=5242880
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_DUPLICATE_THRESHOLD=0.72
AI_LEXICAL_DUPLICATE_THRESHOLD=0.38
AI_DUPLICATE_MAX_DISTANCE_METERS=400
AI_DUPLICATE_MAX_CANDIDATES=50
AI_USE_GEMINI=false

# Set a unique random value before starting the backend.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

GEMINI_API_KEY=
CLOUDINARY_URL=

SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@civiclens.gov
